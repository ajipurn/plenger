---
const sections = [
  { href: "#process", label: "How it works" },
  { href: "#stride", label: "Threat model" },
  { href: "#agentic", label: "Agentic AI" },
  { href: "#local", label: "Privacy" },
];
---

<header class="nav" data-nav>
  <a class="brand" href="#top" aria-label="Plenger, back to top">
    <img src="/mark.svg" alt="" width="28" height="28" />
    <span class="brand-word">plenger</span>
  </a>
  <nav class="nav-links" aria-label="Sections">
    {
      sections.map(({ href, label }) => (
        <a href={href} data-nav-link>
          <span class="nav-roll">
            <span>{label}</span>
            <span aria-hidden="true">{label}</span>
          </span>
        </a>
      ))
    }
    <a href="/docs/">
      <span class="nav-roll"><span>Docs</span><span aria-hidden="true">Docs</span></span>
    </a>
  </nav>
  <div class="nav-actions">
    <a
      class="nav-github"
      href="https://github.com/ajipurn/plenger"
      aria-label="Plenger on GitHub"
      data-cursor-hover
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
        ></path>
      </svg>
      <span>GitHub</span>
    </a>
    <a class="nav-cta" href="#start" data-magnetic data-cursor-hover>
      <span>Get started</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6"></path></svg>
    </a>
  </div>
</header>
