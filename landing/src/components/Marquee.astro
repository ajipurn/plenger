---
// The track loops by half its width, so each half must be wider than any screen.
// Four lines per half cover 2560 px at the largest type size.
const copies = Array.from({ length: 8 }, (_, index) => index);
---

<section class="marquee" aria-label="Plenger stands for Please Let Every Null Get Escaped, Right?">
  <div class="marquee-track" data-marquee aria-hidden="true">
    {
      copies.map(() => (
        <>
          <span class="marquee-item">
            Please Let Every Null Get <em>Escaped,</em> Right?
          </span>
          <span class="marquee-star">✳</span>
        </>
      ))
    }
  </div>
</section>
