---
import Command from "./Command.astro";
import EmblemPoster from "./EmblemPoster.astro";
---

<section class="hero" id="top" data-scene="sphere">
  <EmblemPoster />
  <h1 class="hero-title">
    <span class="hero-line">Security review</span>
    <span class="hero-line">that runs <em>locally.</em></span>
  </h1>
  <div class="hero-foot">
    <p class="hero-copy">
      Plenger reads your code like a careful reviewer. It traces the risk, checks the claim and
      cites the line. One npm package, a local dashboard, and the model you pick.
    </p>
    <div class="hero-actions">
      <Command />
      <a class="link-arrow" href="#process" data-cursor-hover>
        See how it works
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"></path></svg>
      </a>
    </div>
  </div>
</section>
