<section class="showcase" id="dashboard" data-scene="field-dim">
  <div class="showcase-head">
    <p class="section-label">(05) Dashboard</p>
    <h2 data-split>Find it. Track it.<br /><em>Fix</em> it.</h2>
    <p class="showcase-intro" data-fade>
      Projects, scans and findings live in one local dashboard. Triage follows each finding
      across rescans, and every report brings its source evidence along.
    </p>
  </div>
  <div class="showcase-stage" data-showcase>
    <div class="app" aria-hidden="true">
      <div class="app-bar">
        <span class="app-brand"><img src="/logo.svg" alt="" width="24" height="24" />plenger</span>
        <span class="app-tabs">
          <span class="is-active">Findings</span><span>Projects</span><span>Scans</span>
        </span>
        <span class="app-pill">Full coverage · done</span>
      </div>
      <div class="app-body">
        <div class="app-list">
          <div class="app-list-head">
            <span>Findings <b>12</b></span>
            <span class="app-search">Search findings</span>
          </div>
          <div class="app-row is-selected" data-row>
            <span class="sev sev-critical">Critical</span>
            <span class="app-row-title">Model output reaches a shell command</span>
            <span class="app-row-path">agent/tools.py:9</span>
            <span class="status">New</span>
          </div>
          <div class="app-row" data-row>
            <span class="sev sev-high">High</span>
            <span class="app-row-title">Upload path joins a request field without confinement</span>
            <span class="app-row-path">app/routes/files.ts:112</span>
            <span class="status">Triaged</span>
          </div>
          <div class="app-row" data-row>
            <span class="sev sev-high">High</span>
            <span class="app-row-title">Retrieved page text enters the system prompt</span>
            <span class="app-row-path">rag/answer.py:41</span>
            <span class="status">In progress</span>
          </div>
          <div class="app-row" data-row>
            <span class="sev sev-medium">Medium</span>
            <span class="app-row-title">SQL text built from a query parameter</span>
            <span class="app-row-path">api/search.js:67</span>
            <span class="status">New</span>
          </div>
          <div class="app-row" data-row>
            <span class="sev sev-low">Low</span>
            <span class="app-row-title">Tool loop has no step limit</span>
            <span class="app-row-path">agent/loop.py:88</span>
            <span class="status status-done">Resolved</span>
          </div>
        </div>
        <div class="app-detail">
          <p class="app-detail-kicker">Elevation of privilege · CWE-78</p>
          <p class="app-detail-title">Model output reaches a shell command</p>
          <p class="app-detail-text">
            <code>run_command</code> passes the agent's argument to
            <code>subprocess.run</code> with <code>shell=True</code>. A reply shaped by
            <code>user_message</code> can run any command on the host.
          </p>
          <pre class="app-code" is:raw><span class="ln">07</span>    result = subprocess.run(
<span class="ln">08</span>        command,
<span class="hl"><span class="ln">09</span>        shell=True,</span>
<span class="ln">10</span>        capture_output=True,
<span class="ln">11</span>    )</pre>
          <div class="app-detail-foot">
            <span class="app-check">Second review: confirmed</span>
            <span class="app-button">Generate fix prompt</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
