      "properties": {
        "id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mcpMember"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mcpMember"
          }
        }
      },
      "required": [
        "id",
        "framework",
        "location",
        "name",
        "transport",
        "tools",
        "resources",
        "prompts"
      ]
