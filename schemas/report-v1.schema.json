        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/model"
          }
        },
        "llmCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/llmCall"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/agent"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tool"
          }
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mcpServer"
          }
        },
        "mcpClients": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mcpClient"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/prompt"
          }
        },
        "dataStores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dataStore"
          }
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entryPoint"
          }
        },
        "unrecognised": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "module": {
                "type": "string"
              },
              "files": {
                "type": "array",
