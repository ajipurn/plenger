        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "kind": {
          "type": "string",
          "enum": ["http", "mcp"]
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reaches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "handlerPath": {
          "type": "string"
        },
        "trace": {
          "$ref": "#/definitions/traceGaps"
