{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plenger report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "plenger"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["name", "version"]
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": ["python", "javascript", "typescript"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "syntaxErrors": {
            "type": "boolean"
          },
          "facts": {
            "$ref": "#/definitions/facts"
          }
        },
        "required": ["path", "language", "bytes", "lines", "syntaxErrors"]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "declaration",
              "minified",
              "gitignored",
              "symlink",
              "too_large",
              "unreadable",
              "binary",
              "not_utf8"
            ]
          }
        },
        "required": ["path", "reason"]
      }
    },
    "excludedDirs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": ["default", "virtualenv", "gitignore"]
          }
        },
        "required": ["path", "reason"]
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "inventory": {
      "$ref": "#/definitions/inventory"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["active", "suppressed", "unchanged", "new"]
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["functions"]
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "native library",
              "executable",
              "WebAssembly",
              "JVM bytecode",
              "Python package"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["path", "kind", "bytes", "sha256"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "root",
    "files",
    "skipped",
    "excludedDirs",
    "truncated",
    "inventory",
    "findings",
    "durationMs",
    "rules",
    "review"
  ],
  "definitions": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["line", "column", "endLine", "endColumn"]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["path", "line", "column", "endLine", "endColumn"]
    },
    "traceGaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depthLimited": {
          "type": "integer",
          "minimum": 0
        },
        "dynamic": {
          "type": "integer",
          "minimum": 0
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/location"
          }
        }
      },
      "required": ["depthLimited", "dynamic", "locations"]
    },
    "dynamicPart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["param", "name", "call", "other"]
        },
        "ref": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callSites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "const": true
        }
      },
      "required": ["text", "source"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "process",
            "code",
            "file_read",
            "file_write",
            "file_delete",
            "network",
            "database",
            "message",
            "payment",
            "secret",
            "deserialize",
            "browser",
            "llm",
            "agent",
            "mcp"
          ]
        },
        "target": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "via": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/location"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "hosted": {
          "const": true
        },
        "tool": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "enum": ["shell", "program", "arguments"]
        },
        "program": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "query": {
          "const": true
        },
        "template": {
          "const": true
        },
        "operation": {
          "type": "string",
          "enum": ["read", "write", "unknown"]
        },
        "dataInputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "host": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "given": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "sandbox": {
          "type": "string",
          "enum": ["none", "container", "remote"]
        },
        "systemInputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["kind", "target", "location", "via", "inputs"]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "role": {
          "type": "string",
          "enum": ["system", "user", "template"]
        },
        "text": {
          "type": "string"
        },
        "dynamic": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secret": {
          "type": "string"
        },
        "truncated": {
          "const": true
        }
      },
      "required": ["id", "location", "role", "text", "dynamic", "variables", "usedBy"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "target": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential": {
          "type": "string",
          "enum": ["literal", "placeholder", "environment", "parameter", "default", "other"]
        }
      },
      "required": ["id", "framework", "location", "target", "model", "baseUrl", "credential"]
    },
    "llmCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "target": {
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "client": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedTools": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "systemInputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamicPart"
          }
        },
        "outputEffects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capability"
          }
        }
      },
      "required": [
        "id",
        "framework",
        "location",
        "target",
        "scope",
        "model",
        "client",
        "prompts",
        "tools",
        "unresolvedTools",
        "inputs",
        "systemInputs",
        "outputEffects"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "target": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolvedTools": {
          "type": "integer",
          "minimum": 0
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "handler": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "handlerPath": {
                "type": "string"
              }
            },
            "required": ["name", "handler"]
          }
        },
        "delegates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcpClients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "location": {
                "$ref": "#/definitions/location"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/dynamicPart"
                }
              }
            },
            "required": ["location", "inputs"]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "outputEffects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "approval": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "framework",
        "location",
        "target",
        "name",
        "model",
        "tools",
        "unresolvedTools",
        "prompts",
        "nodes",
        "delegates",
        "mcpClients",
        "invocations",
        "capabilities",
        "outputEffects"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "handler": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "via": {
          "type": "string",
          "enum": ["decorator", "class", "factory", "function", "builtin", "agent", "mcp", "schema"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "handlerPath": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "trace": {
          "$ref": "#/definitions/traceGaps"
        }
      },
      "required": [
        "id",
        "framework",
        "location",
        "name",
        "description",
        "handler",
        "params",
        "via",
        "capabilities",
        "server"
      ]
