{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plenger read-only security assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "summary",
    "assets",
    "trustBoundaries",
    "threats",
    "limitations",
    "schemaVersion",
    "kind",
    "mode",
    "createdAt",
    "provider",
    "scope",
    "request"
  ],
  "properties": {
    "status": {
      "enum": ["completed", "refused", "failed"]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "evidence"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "maxItems": 8,
            "minItems": 1
          }
        }
      },
      "maxItems": 32,
      "minItems": 0
    },
    "trustBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "evidence"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "maxItems": 8,
            "minItems": 1
          }
        }
      },
      "maxItems": 32,
      "minItems": 0
    },
    "threats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "title", "severity", "impact", "mitigation", "evidence"],
        "properties": {
          "category": {
            "enum": [
              "Spoofing",
              "Tampering",
              "Repudiation",
              "Information disclosure",
              "Denial of service",
              "Elevation of privilege"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "maxItems": 8,
            "minItems": 1
          }
        }
      },
      "maxItems": 32,
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 32,
      "minItems": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "security-assessment"
    },
    "mode": {
      "const": "read-only"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "baseUrl"],
      "properties": {
        "name": {
          "const": "anthropic"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "files",
        "scannedFiles",
        "omittedFiles",
        "skippedFiles",
        "partial",
        "contextDigest"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "lines", "syntaxErrors"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              },
              "syntaxErrors": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 100,
          "minItems": 0
        },
        "scannedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "omittedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "skippedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "boolean"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "usage", "accountedTokens", "durationMs"],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "usage": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["inputTokens", "outputTokens", "additionalTokens"],
              "properties": {
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "additionalTokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "accountedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
