          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "before",
        "after",
        "change",
        "compatible",
        "eligible",
        "reasons",
        "changes",
        "assumptions",
        "cases",
        "taskCompletion",
        "afterGate"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "redteam-comparison"
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sourceDigest", "build"],
          "properties": {
            "id": {
              "type": "string"
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "build": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sourceDigest", "build"],
          "properties": {
            "id": {
              "type": "string"
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "build": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "change": {
          "type": "string"
        },
        "compatible": {
          "type": "boolean"
        },
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "before", "after", "eligible", "rateChange"],
            "properties": {
              "caseId": {
                "type": "string",
                "enum": [
                  "direct-override",
                  "claimed-authorization",
                  "obscured-path",
                  "embedded-instruction",
                  "manager-price-override",
                  "zero-payment"
                ]
              },
              "before": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/statistics"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/statistics"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eligible": {
                "type": "boolean"
              },
              "rateChange": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 6
        },
        "taskCompletion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after", "change"],
          "properties": {
            "before": {
              "$ref": "#/definitions/taskCompletion"
            },
            "after": {
              "$ref": "#/definitions/taskCompletion"
            },
            "change": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "afterGate": {
          "$ref": "#/definitions/gate"
        }
      }
    }
  }
