{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plenger dynamic run v1",
  "$ref": "#/definitions/run",
  "definitions": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxModelCalls", "maxTokens", "timeoutMs"],
      "properties": {
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "enforcementScope",
        "state",
        "limits",
        "stopReasons",
        "callsAdmitted",
        "callsInFlight",
        "providersUnsettled",
        "observedTokens",
        "outstandingReservedTokens",
        "accountedTokens",
        "remainingCalls",
        "remainingTokens",
        "calls"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "redteam-model-budget"
        },
        "enforcementScope": {
          "const": "submitted-dispatches"
        },
        "state": {
          "type": "string",
          "enum": ["open", "completed", "stopped"]
        },
        "limits": {
          "$ref": "#/definitions/limits"
        },
        "stopReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "model-call-limit",
              "token-limit",
              "deadline",
              "cancelled",
              "invalid-provider-response",
              "invalid-provider-usage",
              "provider-usage-exceeded-reservation"
            ]
          }
        },
        "callsAdmitted": {
          "type": "integer",
          "minimum": 0
        },
        "callsInFlight": {
          "type": "integer",
          "minimum": 0
        },
        "providersUnsettled": {
          "type": "integer",
          "minimum": 0
        },
        "observedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outstandingReservedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "accountedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "remainingCalls": {
          "type": "integer",
          "minimum": 0
        },
        "remainingTokens": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "state",
              "providerSettled",
              "reservation",
              "usage",
              "accounting",
              "accountedTokens"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "purpose": {
                "type": "string",
                "enum": ["setup", "control", "probe", "retry"]
              },
              "state": {
                "type": "string",
                "enum": ["in-flight", "succeeded", "failed", "interrupted"]
              },
              "providerSettled": {
                "type": "boolean"
              },
              "reservation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["inputTokens", "outputTokens", "additionalTokens"],
                "properties": {
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "additionalTokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["inputTokens", "outputTokens", "additionalTokens"],
                    "properties": {
                      "inputTokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "outputTokens": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "additionalTokens": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accounting": {
                "type": "string",
                "enum": ["reserved", "confirmed", "unknown", "overrun"]
              },
              "accountedTokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 1200
        },
        "tokenLimitMode": {
          "const": "observed"
        }
      }
    },
    "securityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "severity", "rationale", "oracle"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "direct-override",
            "claimed-authorization",
            "obscured-path",
            "embedded-instruction",
            "manager-price-override",
            "zero-payment"
          ]
        },
        "version": {
          "const": 1
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "string",
          "enum": ["completed-file-write", "committed-invoice-change", "committed-underpayment"]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "caseId", "supported", "selected", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^scope:[a-f0-9]{24}$"
        },
        "target": {
          "type": "string"
        },
        "caseId": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": ["input", "tool", "mcp", "web", "retrieval"]
        },
        "label": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line", "column", "endLine", "endColumn"],
          "properties": {
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "endColumn": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failOn", "minCoverage", "minimumEvaluable", "suppressions"],
      "properties": {
        "failOn": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "none"]
        },
        "minCoverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimumEvaluable": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "reason"],
            "properties": {
              "caseId": {
                "type": "string",
                "enum": [
                  "direct-override",
                  "claimed-authorization",
                  "obscured-path",
                  "embedded-instruction",
                  "manager-price-override",
                  "zero-payment"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "maxItems": 2
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "root",
        "target",
        "sourceDigest",
        "profile",
        "provider",
        "model",
        "repetitions",
        "limits",
        "cases",
        "scope",
        "requiredScope",
        "policy",
        "build"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "redteam-campaign-plan"
        },
        "root": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile": {
          "type": "string",
          "enum": ["llmfy-file-canary-v1", "vercel-booking-sqlite-v1"]
        },
        "provider": {
          "type": "string",
          "enum": ["openai", "gemini", "ollama", "chatgpt"]
        },
        "model": {
          "type": "string"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "limits": {
          "$ref": "#/definitions/limits"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/securityCase"
          },
          "maxItems": 4,
          "minItems": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/scope"
          },
          "maxItems": 10000
        },
        "requiredScope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^scope:[a-f0-9]{24}$"
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "policy": {
          "$ref": "#/definitions/policy"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "baseUrl", "temperature", "maxOutputTokens"],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            },
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          }
        },
        "scopeIncomplete": {
          "type": "boolean"
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "started",
        "completed",
        "outcome",
        "events",
        "modelCalls",
        "workerName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "clean-control",
            "direct-override",
            "claimed-authorization",
            "obscured-path",
            "embedded-instruction",
            "manager-price-override",
            "zero-payment"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": ["control", "probe"]
        },
        "started": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": ["violation_observed", "not_observed", "inconclusive"]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "stage"],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "type": "string",
                "enum": [
                  "model_tool_proposal",
                  "tool_handler_entered",
                  "tool_handler_returned",
                  "canary_state"
                ]
              },
              "tool": {
                "type": "string"
              },
              "boundary": {
                "type": "string",
                "enum": ["allowed", "forbidden"]
              },
              "markerPresent": {
                "type": "boolean"
              },
              "callId": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              },
              "result": {}
            }
          },
          "maxItems": 256
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "workerName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "content"],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "type": "string",
                "enum": ["user", "assistant"]
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedAmount", "bookingId", "before"],
          "properties": {
            "expectedAmount": {
              "type": "integer",
              "minimum": 1
            },
            "bookingId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bookings", "invoices", "payments"],
              "properties": {
                "bookings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "service", "date", "time"],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "service": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "time": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                },
                "invoices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["bookingId", "amount", "status"],
                    "properties": {
                      "bookingId": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "integer"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                },
                "payments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["bookingId", "amount", "status"],
                    "properties": {
                      "bookingId": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "integer"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                }
              }
            },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bookings", "invoices", "payments"],
              "properties": {
                "bookings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "service", "date", "time"],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "service": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "time": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                },
                "invoices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["bookingId", "amount", "status"],
                    "properties": {
                      "bookingId": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "integer"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                },
                "payments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["bookingId", "amount", "status"],
                    "properties": {
                      "bookingId": {
                        "type": "string"
                      },
                      "amount": {
                        "type": "integer"
                      },
                      "status": {
                        "type": "string"
                      }
                    }
                  },
                  "maxItems": 20
                }
              }
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sequence", "final", "callIds", "after"],
                "properties": {
                  "sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "final": {
                    "type": "boolean"
                  },
                  "callIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "after": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["bookings", "invoices", "payments"],
                    "properties": {
                      "bookings": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["id", "service", "date", "time"],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "service": {
                              "type": "string"
                            },
                            "date": {
                              "type": "string"
                            },
                            "time": {
                              "type": "string"
                            }
                          }
                        },
                        "maxItems": 20
                      },
                      "invoices": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["bookingId", "amount", "status"],
                          "properties": {
                            "bookingId": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "status": {
                              "type": "string"
                            }
                          }
                        },
                        "maxItems": 20
                      },
                      "payments": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["bookingId", "amount", "status"],
                          "properties": {
                            "bookingId": {
                              "type": "string"
                            },
                            "amount": {
                              "type": "integer"
                            },
                            "status": {
                              "type": "string"
                            }
                          }
                        },
                        "maxItems": 20
                      }
                    }
                  }
                }
              },
              "maxItems": 64
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "root",
        "target",
        "sourceDigest",
        "createdAt",
        "finishedAt",
        "state",
        "provider",
        "model",
        "profile",
        "evidenceScope",
        "tokenAccounting",
        "cleanControlPassed",
        "cleanupConfirmed",
        "error",
        "budget",
        "trials"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "redteam-run"
        },
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": ["preparing", "running", "completed", "stopped", "failed"]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": ["llmfy-file-canary-v1", "vercel-booking-sqlite-v1"]
        },
        "evidenceScope": {
          "type": "string",
          "enum": ["isolated-file-canary", "isolated-route-sqlite"]
        },
        "tokenAccounting": {
          "const": "conservative-byte-bound-with-provider-usage"
        },
        "cleanControlPassed": {
          "type": "boolean"
        },
        "cleanupConfirmed": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/definitions/budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/trial"
          },
          "maxItems": 3
        },
        "providerConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "baseUrl", "temperature", "maxOutputTokens"],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            },
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          }
        },
        "backendChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "outcome", "arguments", "before", "after"],
            "properties": {
              "tool": {
                "type": "string"
              },
              "outcome": {
                "type": "string",
                "enum": ["violation_observed", "not_observed", "inconclusive"]
              },
              "arguments": {
                "type": "object"
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bookings", "invoices", "payments"],
                "properties": {
                  "bookings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "service", "date", "time"],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "service": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "time": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  },
                  "invoices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["bookingId", "amount", "status"],
                      "properties": {
                        "bookingId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  },
                  "payments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["bookingId", "amount", "status"],
                      "properties": {
                        "bookingId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["bookings", "invoices", "payments"],
                "properties": {
                  "bookings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "service", "date", "time"],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "service": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "time": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  },
                  "invoices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["bookingId", "amount", "status"],
                      "properties": {
                        "bookingId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  },
                  "payments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["bookingId", "amount", "status"],
                      "properties": {
                        "bookingId": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "maxItems": 20
                  }
                }
              }
            }
          },
          "maxItems": 2
        },
        "backendWorkerName": {
          "type": "string"
        },
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["image", "python", "llmfy"],
              "properties": {
                "image": {
                  "type": "string"
                },
                "python": {
                  "type": "string"
                },
                "llmfy": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["image", "node", "ai", "databaseObserver"],
              "properties": {
                "image": {
                  "type": "string"
                },
                "node": {
                  "type": "string"
                },
                "ai": {
                  "type": "string"
                },
                "databaseObserver": {
                  "const": "committed-snapshots-v1"
                }
              }
            }
          ]
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "planned",
        "counts",
        "evaluable",
        "coverage",
        "rate",
        "interval",
        "comparisonEligible"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "enum": [
            "direct-override",
            "claimed-authorization",
            "obscured-path",
            "embedded-instruction",
            "manager-price-override",
            "zero-payment"
          ]
        },
        "planned": {
          "type": "integer",
          "minimum": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["violation_observed", "not_observed", "inconclusive", "error", "skipped"],
          "properties": {
            "violation_observed": {
              "type": "integer",
              "minimum": 0
            },
            "not_observed": {
              "type": "integer",
              "minimum": 0
            },
            "inconclusive": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evaluable": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "interval": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "confidence", "low", "high"],
              "properties": {
                "method": {
                  "const": "wilson"
                },
                "confidence": {
                  "const": 0.95
                },
                "low": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "high": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "comparisonEligible": {
          "type": "boolean"
        }
      }
    },
    "gate": {
      "type": "object",
