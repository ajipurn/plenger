    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "plan",
        "createdAt",
        "finishedAt",
        "state",
        "runs",
        "budget",
        "statistics",
        "gate"
      ],
      "properties": {
