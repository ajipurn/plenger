{
  "name": "plenger",
  "version": "0.1.0",
  "description": "Static triage for agentic AI projects written in Python, JavaScript and TypeScript",
  "private": true,
  "type": "module",
  "bin": {
    "plenger": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "node src/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "grammars": "node scripts/update-grammars.ts"
  },
  "dependencies": {
    "ignore": "7.0.10",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "files": [
    "dist",
    "grammars"
  ]
}
