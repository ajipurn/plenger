{
  "name": "plenger",
  "author": {
    "name": "Aji Purnomo",
    "email": "hi@aji.is-a.dev"
  },
  "version": "0.1.3",
  "description": "Local security review of repositories: AI source review, STRIDE threat modeling and static triage for agentic AI code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajipurn/plenger.git"
  },
  "homepage": "https://github.com/ajipurn/plenger#readme",
  "bugs": {
    "url": "https://github.com/ajipurn/plenger/issues"
  },
  "keywords": [
    "security",
    "security-review",
    "code-review",
    "sast",
    "threat-modeling",
    "stride",
    "llm",
    "ai-agents",
    "agentic-ai",
    "dashboard"
  ],
  "type": "module",
  "bin": {
    "plenger": "dist/bin.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "node src/bin.ts",
    "dashboard": "pnpm --filter @plenger/dashboard build && node src/dashboard/dev.ts",
    "dashboard:build": "pnpm --filter @plenger/dashboard build",
    "docs:dev": "pnpm --filter @plenger/docs dev",
    "docs:build": "pnpm --filter @plenger/docs build",
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "build:package": "pnpm build && pnpm dashboard:build && node scripts/package-notices.ts",
    "prepack": "pnpm build:package",
    "test:package": "node scripts/smoke-package.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm --filter @plenger/dashboard typecheck && pnpm --filter @plenger/docs typecheck && pnpm lint && pnpm test",
    "qualify:llmfy": "node scripts/qualify-llmfy.ts",
    "qualify:vercel": "node scripts/qualify-vercel.ts",
    "grammars": "node scripts/update-grammars.ts",
    "bench": "node scripts/benchmark.ts",
    "evaluate": "node scripts/evaluate.ts",
    "docs:rules": "node scripts/rules-doc.ts",
    "schemas": "node scripts/report-schemas.ts",
    "generate": "pnpm docs:rules && pnpm schemas"
  },
  "dependencies": {
    "ignore": "7.0.10",
    "smol-toml": "1.9.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.8.1"
  },
  "files": [
    "dist/**/*.js",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dashboard/dist",
    "grammars",
    "runtimes",
    "!runtimes/llmfy/.dockerignore",
    "!runtimes/llmfy/requirements.in",
    "schemas"
  ]
}
