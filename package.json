{
  "name": "plenger-cli",
  "version": "0.1.0",
  "description": "Red-teaming and static triage for agentic AI projects written in Python, JavaScript and TypeScript",
  "private": true,
  "type": "module",
  "bin": {
    "plenger": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "node src/bin.ts",
    "dashboard": "pnpm --filter @plenger/dashboard build && node src/dashboard/dev.ts",
    "dashboard:build": "pnpm --filter @plenger/dashboard build",
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "build:package": "pnpm build && pnpm dashboard:build && node scripts/package-notices.ts",
    "prepack": "pnpm build:package",
    "test:package": "node scripts/smoke-package.ts",
    "build:binary": "node scripts/build-binary.ts",
    "test:binary": "node scripts/smoke-binary.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm --filter @plenger/dashboard typecheck && pnpm lint && pnpm test",
    "qualify:llmfy": "node scripts/qualify-llmfy.ts",
    "qualify:vercel": "node scripts/qualify-vercel.ts",
    "grammars": "node scripts/update-grammars.ts",
    "bench": "node scripts/benchmark.ts",
    "docs:rules": "node scripts/rules-doc.ts",
    "schemas": "node scripts/report-schemas.ts",
    "generate": "pnpm docs:rules && pnpm schemas"
  },
  "dependencies": {
    "ignore": "7.0.10",
    "smol-toml": "1.9.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.8.1"
  },
  "files": [
    "dist/**/*.js",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dashboard/dist",
    "grammars",
    "runtimes",
    "!runtimes/llmfy/.dockerignore",
    "!runtimes/llmfy/requirements.in",
    "schemas"
  ]
}
